{{/* ── SEO: Open Graph, Twitter Cards, Schema.org JSON-LD ── */}}

{{- $title := .Title -}}
{{- $desc := .Description | default .Site.Params.description -}}
{{- $url := .Permalink -}}
{{- $siteName := .Site.Title -}}
{{- $isResource := eq .Section "resources" -}}
{{- $isBlog := eq .Section "blog" -}}
{{- $isAssessment := eq .Section "assessment" -}}
{{- $ogImage := "/img/og/default.svg" -}}
{{- if $isBlog -}}
  {{- $ogImage = printf "/img/blog/%s.svg" .File.ContentBaseName -}}
{{- end -}}

{{/* Canonical URL */}}
<link rel="canonical" href="{{ $url }}">
{{ if .IsTranslated }}{{ range .Translations }}
<link rel="alternate" hreflang="{{ .Lang }}" href="{{ .Permalink }}">
{{ end }}{{ end }}
<link rel="alternate" hreflang="{{ .Site.Language.Lang }}" href="{{ .Permalink }}">

{{/* Open Graph */}}
<meta property="og:type" content="{{ cond .IsHome "website" "article" }}">
<meta property="og:title" content="{{ $title }}">
<meta property="og:description" content="{{ $desc | truncate 200 }}">
<meta property="og:url" content="{{ $url }}">
<meta property="og:site_name" content="{{ $siteName }}">
<meta property="og:locale" content="en_US">
<meta property="og:image" content="{{ .Site.BaseURL }}{{ strings.TrimPrefix "/" $ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{{- with .Date }}
<meta property="article:published_time" content="{{ .Format "2006-01-02T15:04:05Z07:00" }}">
{{- end }}

{{/* Twitter Card */}}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ $title }}">
<meta name="twitter:description" content="{{ $desc | truncate 200 }}">
<meta name="twitter:image" content="{{ .Site.BaseURL }}{{ strings.TrimPrefix "/" $ogImage }}">

{{/* Schema.org JSON-LD */}}
{{- if .IsHome }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "{{ $siteName }}",
  "url": "{{ .Site.BaseURL }}",
  "description": "{{ .Site.Params.description }}",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ .Site.BaseURL }}?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>
{{- else if $isResource }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": "{{ .Title }}",
  "description": "{{ $desc | truncate 300 }}",
  "url": "{{ $url }}",
  "provider": {
    "@type": "Organization",
    "name": "LearnLattice",
    "url": "{{ .Site.BaseURL }}"
  },
  "isAccessibleForFree": true,
  "license": "https://creativecommons.org/licenses/by-sa/4.0/",
  "inLanguage": "en",
  "learningResourceType": "{{ (index .Params.resource_types 0) | default "Resource" }}",
  "educationalLevel": [{{ range $i, $l := (.Params.year_levels | default (slice)) }}{{ if $i }}, {{ end }}"{{ $l }}"{{ end }}],
  "teaches": [{{ range $i, $t := (.Params.tags | default (slice)) }}{{ if $i }}, {{ end }}"{{ $t }}"{{ end }}],
  "about": [{{ range $i, $s := (.Params.subjects | default (slice)) }}{{ if $i }}, {{ end }}"{{ $s }}"{{ end }}],
  "educationalFramework": "IB Middle Years Programme",
  "datePublished": "{{ .Date.Format "2006-01-02" }}",
  "dateModified": "{{ .Lastmod.Format "2006-01-02" }}"
  {{- with .Params.key_concept }},
  "keywords": "{{ . }}"
  {{- end }}
}
</script>
{{- else if $isBlog }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ .Title }}",
  "description": "{{ $desc | truncate 300 }}",
  "url": "{{ $url }}",
  "image": "{{ .Site.BaseURL }}{{ strings.TrimPrefix "/" $ogImage }}",
  "datePublished": "{{ .Date.Format "2006-01-02" }}",
  "dateModified": "{{ .Lastmod.Format "2006-01-02" }}",
  "author": {
    "@type": "Person",
    "name": "Corey Briscoe",
    "url": "{{ .Site.BaseURL }}about/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "LearnLattice",
    "url": "{{ .Site.BaseURL }}"
  },
  "inLanguage": "en",
  "isAccessibleForFree": true
}
</script>
{{- else if $isAssessment }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is MYP {{ .Title }}?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ $desc | truncate 300 }}"
      }
    }
  ]
}
</script>
{{- else }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ .Title }}",
  "description": "{{ $desc | truncate 300 }}",
  "url": "{{ $url }}",
  "isPartOf": {
    "@type": "WebSite",
    "name": "{{ $siteName }}",
    "url": "{{ .Site.BaseURL }}"
  }
}
</script>
{{- end }}
