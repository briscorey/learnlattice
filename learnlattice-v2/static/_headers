# Cache HTML pages for 1 hour, stale-while-revalidate for instant loads
/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Cache CSS/JS for 1 year (they have version hashes in URLs)
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images for 1 month
/img/*
  Cache-Control: public, max-age=2592000

# Cache fonts for 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache game assets for 1 week
/games/*
  Cache-Control: public, max-age=604800

# Cache revision data for 1 day
/js/revision-data.json
  Cache-Control: public, max-age=86400
